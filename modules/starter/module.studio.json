{
  "version": 1,
  "id": "starter",
  "name": "Starter",
  "about": "A room, a door, a pit, a platform and a spirit: the module the studio starts from.\nMIT -- the textures and the spirit sheet are our own; see LICENSE.",
  "propIdBase": 1000,
  "props": [
    {
      "id": 1000,
      "name": "spirit",
      "radius": 0.45,
      "height": 1.4,
      "speed": 5.2,
      "solid": true,
      "art": {
        "kind": "atlas",
        "sheet": "SPIR",
        "states": {
          "0": "idle",
          "1": "walk",
          "2": "Attack",
          "3": "idle",
          "4": "death"
        }
      },
      "scale": "2"
    }
  ],
  "mobs": {
    "missiles": {},
    "mobs": {
      "spirit": {
        "hp": 80,
        "turn_speed": 14,
        "sight": "42.6667",
        "pain_chance": 128,
        "infighting": true,
        "corpse": true,
        "initial": "look",
        "flying": true,
        "hover_z": "0.4000",
        "vars": {
          "ready": 0
        },
        "states": {
          "look": {
            "anim": 0,
            "move": "stop",
            "face": "hold",
            "transitions": [
              {
                "to": "chase",
                "when": [
                  {
                    "cond": "has_target"
                  },
                  {
                    "cond": "target_visible"
                  }
                ]
              }
            ]
          },
          "chase": {
            "anim": 1,
            "move": "chase",
            "face": "target",
            "interruptible": true,
            "transitions": [
              {
                "to": "look",
                "when": [
                  {
                    "cond": "has_target",
                    "negate": true
                  }
                ]
              },
              {
                "to": "missile",
                "when": [
                  {
                    "cond": "target_within",
                    "distance": "1.6667"
                  },
                  {
                    "cond": "target_visible"
                  },
                  {
                    "cond": "cooldown_ready",
                    "var": "ready"
                  }
                ]
              }
            ]
          },
          "pain": {
            "anim": 3,
            "move": "stop",
            "face": "hold",
            "ticks": 10,
            "next": "chase"
          },
          "death": {
            "anim": 4,
            "move": "stop",
            "face": "hold",
            "solid": false,
            "ticks": 100,
            "next": "death"
          },
          "missile": {
            "anim": 2,
            "move": "stop",
            "face": "target",
            "ticks": 20,
            "next": "chase",
            "interruptible": true,
            "sequence": [
              {
                "at": 0,
                "action": "face"
              },
              {
                "at": 10,
                "action": "melee",
                "damage": 6,
                "range": "1.6667"
              },
              {
                "at": 10,
                "action": "set_cooldown",
                "var": "ready",
                "ticks": 90
              }
            ]
          }
        }
      }
    }
  },
  "scripts": {
    "starter.lua": "-- The starter module's own script: what a player's swing costs a monster.\n--\n-- The engine reports that a swing reached something, and mobs.lua's on_attack\n-- prices it (docs/INTERACTION.md): a monster's from its `swing`, a player's\n-- from the weapon in hand -- and, with no weapons, `mobs.player_damage`. This\n-- module has no weapons, so it says that number. It used to add an on_attack\n-- of its own, which ran BESIDE mobs.lua's (hooks are a list): every swing that\n-- landed cost twice, a monster's bite on the player included.\nif mobs ~= nil then mobs.player_damage = 10 end\n"
  },
