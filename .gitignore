# --- Shared by every repository of the workspace. These lines came from the
# workspace's .gitignore, which covered this folder until it became a
# repository of its own (2026-10-14).
build/
builds/
dist/
node_modules/
.cache/
*.o
*.a
*.dSYM/
.DS_Store
compile_commands.json
*~
# Development TLS material: the private key must never be committed.
certs/
*.pem
# Rendered audio is output, regenerated by running the renderer again; git
# history is permanent, so one accidental add would weigh the repository down.
*.wav
emsdk/
third_party/
client/wasm/dist/
.dnp-state/

# The DOOM fixtures live in the private workspace (doom/, linked in by
# doom/install.sh): nothing taken from DOOM is part of the public engine.
/maps/doom1
/maps/doom_map01.map
/maps/doom.lua
/maps/doom_monsters.lua
/maps/mobs/doom_monsters.lua
/maps/scripts/doom.lua
/tools/wad
/scripts/run_doomworld.sh
/test/doom
